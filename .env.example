# J.A.R.V.I.S. Environment Configuration Template
# Copy this file to .env and configure for your current node environment

# Node Identification
JARVIS_NODE_ID=node2-dev
JARVIS_NODE_ROLE=NODE2
JARVIS_ENV=development
JARVIS_DEBUG=true

# Network & Server Settings
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_API_KEY=jarvis-dev-insecure-key-change-me

# Security & Sandbox
JARVIS_ALLOWLIST_ENABLED=true
JARVIS_CONFIRM_YELLOW_ACTIONS=true
JARVIS_CONFIRM_RED_ACTIONS=true

# Storage & Database
JARVIS_DB_PATH=./data/jarvis.db

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
JARVIS_LOG_LEVEL=INFO

# LLM Configuration
JARVIS_LLM_PROVIDER=ollama
JARVIS_LLM_MODEL=qwen2.5:7b
JARVIS_LLM_BASE_URL=http://localhost:11434
JARVIS_LLM_API_KEY=
JARVIS_LLM_MAX_TOKENS=4096
JARVIS_LLM_TEMPERATURE=0.7
JARVIS_LLM_TIMEOUT=120.0

# Ollama-specific (for i5-14400 CORE)
JARVIS_OLLAMA_HOST=http://localhost:11434
JARVIS_OLLAMA_MODEL=qwen2.5:7b

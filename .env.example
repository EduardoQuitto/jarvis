# J.A.R.V.I.S. Environment Configuration Template
# Copy this file to .env and configure for your current node environment

# Node Identification
JARVIS_NODE_ID=node2-dev
JARVIS_NODE_ROLE=NODE2
JARVIS_ENV=development
JARVIS_DEBUG=true

# Network & Server Settings
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_API_KEY=jarvis-dev-insecure-key-change-me

# Security & Sandbox
JARVIS_ALLOWLIST_ENABLED=true
JARVIS_CONFIRM_YELLOW_ACTIONS=true
JARVIS_CONFIRM_RED_ACTIONS=true

# Storage & Database
JARVIS_DB_PATH=./data/jarvis.db

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
JARVIS_LOG_LEVEL=INFO

# LLM Configuration
JARVIS_LLM_PROVIDER=ollama
JARVIS_LLM_MODEL=qwen2.5:7b
JARVIS_LLM_BASE_URL=http://localhost:11434
JARVIS_LLM_API_KEY=
JARVIS_LLM_MAX_TOKENS=4096
JARVIS_LLM_TEMPERATURE=0.7
JARVIS_LLM_TIMEOUT=120.0

# Ollama-specific (for i5-14400 CORE)
JARVIS_OLLAMA_HOST=http://localhost:11434
JARVIS_OLLAMA_MODEL=qwen2.5:7b

# Google AI Studio (Gemini) cloud fallback. Empty key = disabled (Ollama stays primary).
# NEVER commit a real key here — keep it only in your local .env (gitignored).
# The Gemini key lives ONLY on the SERVER. A CORE without direct Gemini access
# points this slot at the SERVER relay instead (node key, not the Gemini key):
#   JARVIS_GOOGLE_BASE_URL=http://<server>:8000/api/llm
JARVIS_GOOGLE_API_KEY=
JARVIS_GOOGLE_MODEL=gemini-3.7-flash
JARVIS_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Remote SERVER bridge (CORE -> SERVER). Empty = disabled.
JARVIS_SERVER_URL=
JARVIS_SERVER_API_KEY=
JARVIS_SERVER_TIMEOUT=30.0

# CORE presence: auto-registration + heartbeat on the SERVER.
# Interval in seconds (default 30). Only active when JARVIS_SERVER_URL is set.
JARVIS_SERVER_HEARTBEAT_INTERVAL=30.0
# Central state (Phase 12): SERVER = source of truth, CORE = compute plane.
# Disabled by default (local SQLite behavior preserved for tests/dev).
JARVIS_CENTRAL_STATE_ENABLED=false
# When true, central-state failures are explicit errors (no silent local fallback).
JARVIS_CENTRAL_STATE_REQUIRED=false
# Optional LAN identity announced to the SERVER. Empty/0 = not announced.
# The Core never invents an inbound endpoint: without these, no IP/port is sent.
JARVIS_NODE_ADVERTISE_IP=
JARVIS_NODE_ADVERTISE_PORT=0
